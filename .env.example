APP_ENV=development
APP_NAME=mwengenharia
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://mw:mw@postgres:5432/mwengenharia
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=mw_refresh
REFRESH_COOKIE_SECURE=false

S3_ENDPOINT=http://s3mock:9090
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mwengenharia
S3_ACCESS_KEY=dummy
S3_SECRET_KEY=dummy
S3_PRESIGN_SECONDS=900

LLM_PROVIDER=disabled

# Bootstrap inicial - preencher somente no ambiente local/seguro.
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
