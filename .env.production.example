APP_ENV=production
APP_NAME=mwengenharia
APP_PORT=8080

POSTGRES_DB=mwengenharia
POSTGRES_USER=mw
POSTGRES_PASSWORD=replace-with-a-strong-database-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=mw_refresh
REFRESH_COOKIE_SECURE=true

S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://files.example.com
S3_REGION=us-east-1
S3_BUCKET=mwengenharia
S3_ACCESS_KEY=replace-with-object-storage-access-key
S3_SECRET_KEY=replace-with-object-storage-secret
S3_PRESIGN_SECONDS=900
